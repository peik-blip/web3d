  "chapter_store": "Space and use",
  "caption_store": "The shop is furnished and the products are placed so that the space works for the customer. This is about use, not looks.",
  "street": "From the street",
  "drawing": "Drawing",
  "use": "Use",
  "areas": "Areas",
  "whole": "Whole shop",
  "route": "Route",
  "close": "Closer",
  "ring": "Spacious and calm",
  "aisles": "Lots on display, still clear",
  "bays": "Clear sections",
  "note_street": "",
  "note_drawing": "",
  "note_use": "The space in use: where customers come in, what the window shows, where the products are, where they try things on.",
  "note_areas": "Product areas as they are now. Next, three ways to furnish the same space.",
  "caption_ring": "All products on the walls, a low table under a lamp in the middle.",
  "caption_aisles": "Low double-sided racks in rows, shoes and folded clothes on the walls.",
  "caption_bays": "Each type of clothing has its own section along the same wall; the other side stays open.",
  "note_ring_whole": "Oak and steel shelving runs around the walls, and the corners stay open.",
  "note_ring_route": "The customer walks along the walls of the room and around the table.",
  "note_ring_close": "The whole room is visible at a glance.",
  "note_aisles_whole": "The racks are lower than shoulder height, and tall shelving runs along the walls.",
  "note_aisles_route": "The customer walks through the aisles, one row at a time.",
  "note_aisles_close": "The whole shop is visible over the racks.",
  "note_bays_whole": "The ends of the sections divide the wall into small rooms, each with its own color.",
  "note_bays_route": "The customer walks through the shop and steps into the section they are looking for.",
  "note_bays_close": "Shirts, jackets and jeans each have their own place.",
