 "strings": {
  "chapter_store": "Tila ja käyttö",
  "caption_store": "Kauppa kalustetaan ja tuotteet sijoitetaan niin, että tila toimii asiakkaalle. Kyse on käytöstä, ei ilmeestä.",
  "furnished": "Kalustettu",
  "empty": "Tyhjä tila",
  "use": "Käyttö",
  "areas": "Alueet",
  "whole": "Koko kauppa",
  "route": "Kulku",
  "close": "Lähempää",
  "ring": "Väljä ja rauhallinen",
  "aisles": "Paljon esillä, silti selkeä",
  "bays": "Selkeät osastot",
  "note_furnished": "",
  "note_empty": "Sama tila tyhjänä: vain runko ja seinät.",
  "note_use": "Tilan käyttö lattiassa: sisäänkäynti, ikkuna, tuotteet, pukukopit, kassa ja peilit.",
  "note_route_now": "Asiakas tulee ovesta, kiertää tuotteiden ohi sovitukseen ja päätyy kassalle.",
  "note_areas": "Tuotealueet nyt. Seuraavaksi kolme tapaa kalustaa sama tila.",
  "caption_ring": "Kaikki tuotteet seinillä, keskellä matala pöytä valaisimen alla.",
  "caption_aisles": "Matalat kaksipuoliset rekit riveissä, seinillä kengät ja taitetut vaatteet.",
  "caption_bays": "Jokaisella vaatelajilla oma osasto saman seinän varrella; toinen puoli pysyy väljänä.",
  "note_ring_whole": "Tammi-teräshyllystö kiertää seinät, ja kulmat jäävät väljiksi.",
  "note_ring_route": "Asiakas kiertää huoneen seiniä pitkin ja pöydän ympäri.",
  "note_ring_close": "Huoneen näkee yhdellä silmäyksellä.",
  "note_aisles_whole": "Rekit ovat olkapäätä matalampia, ja seinillä kulkee korkea hyllystö.",
  "note_aisles_route": "Asiakas kulkee käytävät läpi, rivi kerrallaan.",
  "note_aisles_close": "Koko kaupan näkee rekkien yli.",
  "note_bays_whole": "Osastojen päädyt jakavat seinän pieniksi huoneiksi, kullakin oma värinsä.",
  "note_bays_route": "Asiakas kulkee kaupan läpi ja poikkeaa siihen osastoon, jota hakee.",
  "note_bays_close": "Paidat, takit ja farkut löytyvät kukin omasta paikastaan.",
  "hint": "Käännä vetämällä sivulle.",
  "loading": "Ladataan…",
  "error": "3D-näkymää ei voitu ladata."
